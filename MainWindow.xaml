<ui:FluentWindow
        x:Class="BatchRename.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:BatchRename.Converters"
        xmlns:models="clr-namespace:BatchRename.Models"
        Title="Batch Rename"
        Icon="pack://application:,,,/Assets/App.ico"
        Width="700"
        Height="600"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver">

        <ui:FluentWindow.Resources>

                <!-- ── Converters ──────────────────────────────────────────────── -->
                <conv:BoolToVisibilityConverter          x:Key="BoolVis"/>
                <conv:InverseBoolToVisibilityConverter   x:Key="InvBoolVis"/>
                <conv:InverseBoolConverter               x:Key="InvBool"/>
                <conv:OperationTypeToVisibilityConverter x:Key="TypeVis"/>
                <conv:EnumToBoolConverter                x:Key="EnumBool"/>
                <conv:StringEmptyToVisibilityConverter   x:Key="EmptyVis"/>

                <!-- ── Field label ─────────────────────────────────────────────── -->
                <Style x:Key="FieldLabel"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{StaticResource BrushTextSecondary}"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="Margin"
                                Value="0,0,0,4"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                </Style>

        <Style x:Key="OptionRadio"
                TargetType="RadioButton"
                BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin"
                    Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="CompactSpinNumberBox"
               TargetType="ui:NumberBox"
               BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="MinHeight"
                    Value="32"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="SpinButtonPlacementMode"
                    Value="Compact"/>
        </Style>

                <!-- ── Column header label used in the rules ItemsControl ──────── -->
                <Style x:Key="ColHeader"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="11"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Setter Property="Margin"
                                Value="4,0"/>
                </Style>

                <!-- ── Add Rule context menu ───────────────────────────────────── -->
                <ContextMenu x:Key="AddOpMenu">
                        <MenuItem Header="Find &amp; Replace"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="FindReplace"/>
                        <MenuItem Header="Insert Text"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="InsertText"/>
                        <MenuItem Header="Remove Characters"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="RemoveRange"/>
                        <MenuItem Header="Add Sequence"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="AddSequence"/>
                        <Separator/>
                        <MenuItem Header="Change Case"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="ChangeCase"/>
                        <MenuItem Header="Replace Spaces"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="ReplaceSpaces"/>
                        <MenuItem Header="Trim Whitespace"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="TrimSpaces"/>
                        <Separator/>
                        <MenuItem Header="Change Extension"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="ChangeExtension"/>
                        <MenuItem Header="Remove Numbers"
                                  Command="{Binding AddOperationCommand}"
                                  CommandParameter="RemoveNumbers"/>
                </ContextMenu>

                <!--
            Files DataGrid styles.
            Header height=32 and bold text to match the rules column header row.
            Row alternation for readability.
            Text uses primary brush (black in light, white in dark) throughout.
        -->
                <Style x:Key="FilesColHeader"
                       TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="{StaticResource BrushControlFillDefault}"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Padding"
                                Value="10,0"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource BrushCardBorder}"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                        <Setter Property="Height"
                                Value="32"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                   FontSize="11"
                                                                   FontWeight="{TemplateBinding FontWeight}"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left"/>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="FilesCell"
                       TargetType="DataGridCell">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="10,0"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource BrushTextPrimary}"/>
                </Style>

                <!-- Row style: primary text, alternation, hover highlight. No gray-out for unchanged. -->
                <Style x:Key="FileRow"
                       TargetType="DataGridRow">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="Height"
                                Value="34"/>
                        <Style.Triggers>
                                <Trigger Property="AlternationIndex"
                                         Value="1">
                                        <Setter Property="Background"
                                                Value="{StaticResource BrushSubtleFillSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource BrushSubtleFillTertiary}"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

        </ui:FluentWindow.Resources>

        <!-- ═══ ROOT GRID ════════════════════════════════════════════════════ -->
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- TitleBar  -->
                        <RowDefinition Height="*"/>
                        <!-- Content   -->
                        <RowDefinition Height="Auto"/>
                        <!-- Success   -->
                        <RowDefinition Height="Auto"/>
                        <!-- Footer    -->
                </Grid.RowDefinitions>

                <!-- ── TitleBar ──────────────────────────────────────────────── -->
                <ui:TitleBar Grid.Row="0"
                             Title="Batch Rename"
                             ShowMinimize="True"
                             ShowMaximize="True">
                        <ui:TitleBar.Icon>
                                <ui:ImageIcon Source="pack://application:,,,/Assets/App.ico"/>
                        </ui:TitleBar.Icon>
                </ui:TitleBar>

                <!-- ── Main content: vertical two-section split ──────────────── -->
                <!--
            Both sections use Height="*" so they are equal by default.
            MinHeight on each RowDefinition is calculated as:
              header (46px) + 1px border + empty-state content (~110px) = 157px → use 200px for comfort.
            This guarantees the empty-state graphic is never clipped by the GridSplitter.
        -->
                <Grid Grid.Row="1"
                      Margin="12,8,12,8">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="*"
                                               MinHeight="200"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"
                                               MinHeight="200"/>
                        </Grid.RowDefinitions>

                        <!-- ══ RULES SECTION ═══════════════════════════════════════ -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BrushCardBackground}"
                                BorderBrush="{StaticResource BrushCardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <!-- Header: fixed at 46px (9px padding + 28px button + 9px padding) -->
                                                <RowDefinition Height="46"/>
                                                <!-- Column header strip: visible only when rules exist -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Scrollable content / empty state -->
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Section header -->
                                        <Border Grid.Row="0"
                                                BorderBrush="{StaticResource BrushCardBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,0">
                                                <Grid VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="Rules"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                                           Margin="0,0,10,0"/>
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource BrushTextTertiary}">
                                    <Run Text="{Binding Operations.Count, Mode=OneWay}"/>
                                    <Run Text="rule(s)"/>
                                                                </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                                <!-- Add Rule button with dropdown -->
                                                                <ui:Button Appearance="Primary"
                                                                           Margin="0,0,7,0"
                                                                           Height="28"
                                                                           Padding="10,0"
                                                                           x:Name="AddRuleBtn"
                                                                           ContextMenu="{StaticResource AddOpMenu}"
                                                                           Click="AddRuleBtn_Click">
                                                                        <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="Add24"
                                                                                               Margin="0,0,5,0"/>
                                                                                <TextBlock Text="Add Rule"/>
                                                                                <ui:SymbolIcon Symbol="ChevronDown24"
                                                                                               FontSize="10"
                                                                                               Margin="5,0,0,0"/>
                                                                        </StackPanel>
                                                                </ui:Button>
                                                                <!-- Clear Rules button with X icon -->
                                                                <ui:Button Appearance="Secondary"
                                                                           Height="28"
                                                                           Padding="10,0"
                                                                           Command="{Binding ClearOperationsCommand}"
                                                                           ToolTip="Remove all rules">
                                                                        <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="Dismiss24"
                                                                                               Margin="0,0,6,0"/>
                                                                                <TextBlock Text="Clear Rules"/>
                                                                        </StackPanel>
                                                                </ui:Button>
                                                        </StackPanel>
                                                </Grid>
                                        </Border>

                                        <!-- Column headers (hidden when list is empty) -->
                                        <Border Grid.Row="1"
                                                Height="32"
                                                Background="{StaticResource BrushControlFillTertiary}"
                                                BorderBrush="{StaticResource BrushCardBorder}"
                                                BorderThickness="0,0,0,1"
                                                Visibility="{Binding HasOperations, Converter={StaticResource BoolVis}}">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="38"/>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="Rule"
                                                                   Style="{StaticResource ColHeader}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="Description"
                                                                   Style="{StaticResource ColHeader}"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="On"
                                                                   Style="{StaticResource ColHeader}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0"/>
                                                </Grid>
                                        </Border>

                                        <!-- Empty state -->
                                        <StackPanel Grid.Row="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Opacity="0.4"
                                                    Visibility="{Binding HasOperations, Converter={StaticResource InvBoolVis}}">
                                                <ui:SymbolIcon Symbol="Wand24"
                                                               FontSize="36"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>
                                                <TextBlock Text="No rules yet"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                                <TextBlock Text="Click Add Rule to begin"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Rules ItemsControl -->
                                        <ScrollViewer Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasOperations, Converter={StaticResource BoolVis}}">
                                                <ItemsControl ItemsSource="{Binding Operations}"
                                                              x:Name="RulesItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:RenameOperation}">
                                                                        <Border BorderBrush="{StaticResource BrushCardBorder}"
                                                                                BorderThickness="0,0,0,1">
                                                                                <StackPanel>

                                                                                        <!-- Compact row -->
                                                                                        <Grid MinHeight="38">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="38"/>
                                                                                                        <ColumnDefinition Width="170"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                        <ColumnDefinition Width="60"/>
                                                                                                        <ColumnDefinition Width="64"/>
                                                                                                        <ColumnDefinition Width="44"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Grid.Style>
                                                                                                        <Style TargetType="Grid">
                                                                                                                <Style.Triggers>
                                                                                                                        <Trigger Property="IsMouseOver"
                                                                                                                                 Value="True">
                                                                                                                                <Setter Property="Background"
                                                                                                                                        Value="{StaticResource BrushSubtleFillSecondary}"/>
                                                                                                                        </Trigger>
                                                                                                                </Style.Triggers>
                                                                                                        </Style>
                                                                                                </Grid.Style>

                                                                                                <!-- Col 0: expand chevron -->
                                                                                                <Button Grid.Column="0"
                                                                                                        Width="26"
                                                                                                        Height="26"
                                                                                                        Padding="0"
                                                                                                        Background="Transparent"
                                                                                                        BorderThickness="0"
                                                                                                        HorizontalAlignment="Center"
                                                                                                        VerticalAlignment="Center"
                                                                                                        ToolTip="Expand / collapse configuration"
                                                                                                        Command="{Binding DataContext.ToggleOperationExpandedCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                        CommandParameter="{Binding}">
                                                                                                        <ui:SymbolIcon FontSize="11">
                                                                                                                <ui:SymbolIcon.Style>
                                                                                                                        <Style TargetType="ui:SymbolIcon">
                                                                                                                                <Setter Property="Symbol"
                                                                                                                                        Value="ChevronRight24"/>
                                                                                                                                <Style.Triggers>
                                                                                                                                        <DataTrigger Binding="{Binding IsExpanded}"
                                                                                                                                                     Value="True">
                                                                                                                                                <Setter Property="Symbol"
                                                                                                                                                        Value="ChevronDown24"/>
                                                                                                                                        </DataTrigger>
                                                                                                                                </Style.Triggers>
                                                                                                                        </Style>
                                                                                                                </ui:SymbolIcon.Style>
                                                                                                        </ui:SymbolIcon>
                                                                                                </Button>

                                                                                                <!-- Col 1: type icon + name -->
                                                                                                <StackPanel Grid.Column="1"
                                                                                                            Orientation="Horizontal"
                                                                                                            VerticalAlignment="Center"
                                                                                                            Margin="4,0">
                                                                                                        <TextBlock Text="{Binding TypeGlyph}"
                                                                                                                   FontFamily="Segoe Fluent Icons"
                                                                                                                   FontSize="14"
                                                                                                                   Foreground="{StaticResource BrushAccentPrimary}"
                                                                                                                   Margin="0,0,8,0"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                                                                   FontSize="12"
                                                                                                                   FontWeight="Medium"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                </StackPanel>

                                                                                                <!-- Col 2: description -->
                                                                                                <TextBlock Grid.Column="2"
                                                                                                           Text="{Binding Description}"
                                                                                                           FontSize="12"
                                                                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                                                                           VerticalAlignment="Center"
                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                           Margin="10,0"/>

                                                                                                <!-- Col 3: enabled toggle -->
                                                                                                <ui:ToggleSwitch Grid.Column="3"
                                                                                                                 IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                 HorizontalAlignment="Center"
                                                                                                                 VerticalAlignment="Center"
                                                                                                                 Margin="0"/>

                                                                                                <!-- Col 4: move up / down -->
                                                                                                <StackPanel Grid.Column="4"
                                                                                                            Orientation="Horizontal"
                                                                                                            HorizontalAlignment="Center"
                                                                                                            VerticalAlignment="Center">
                                                                                                        <Button Width="26"
                                                                                                                Height="26"
                                                                                                                Padding="0"
                                                                                                                Background="Transparent"
                                                                                                                BorderThickness="0"
                                                                                                                ToolTip="Move rule up"
                                                                                                                Command="{Binding DataContext.MoveOperationUpCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                CommandParameter="{Binding}">
                                                                                                                <ui:SymbolIcon Symbol="ChevronUp24"
                                                                                                                               FontSize="11"/>
                                                                                                        </Button>
                                                                                                        <Button Width="26"
                                                                                                                Height="26"
                                                                                                                Padding="0"
                                                                                                                Background="Transparent"
                                                                                                                BorderThickness="0"
                                                                                                                ToolTip="Move rule down"
                                                                                                                Command="{Binding DataContext.MoveOperationDownCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                CommandParameter="{Binding}">
                                                                                                                <ui:SymbolIcon Symbol="ChevronDown24"
                                                                                                                               FontSize="11"/>
                                                                                                        </Button>
                                                                                                </StackPanel>

                                                                                                <!-- Col 5: delete -->
                                                                                                <Button Grid.Column="5"
                                                                                                        Width="28"
                                                                                                        Height="28"
                                                                                                        Padding="0"
                                                                                                        Background="Transparent"
                                                                                                        BorderThickness="0"
                                                                                                        HorizontalAlignment="Center"
                                                                                                        VerticalAlignment="Center"
                                                                                                        ToolTip="Remove rule"
                                                                                                        Command="{Binding DataContext.RemoveOperationCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                        CommandParameter="{Binding}">
                                                                                                        <ui:SymbolIcon Symbol="Delete24"
                                                                                                                       FontSize="13"
                                                                                                                       Foreground="{StaticResource BrushCritical}"/>
                                                                                                </Button>
                                                                                        </Grid>

                                                                                        <!-- Expandable configuration panel -->
                                                                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}"
                                                                                                Background="{StaticResource BrushSubtleFillSecondary}"
                                                                                                BorderBrush="{StaticResource BrushAccentPrimary}"
                                                                                                BorderThickness="3,0,0,0"
                                                                                                Padding="20,14,20,16">
                                                                                                <Grid>

                                                                                                        <!-- FIND & REPLACE -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=FindReplace}">
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="12"/>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="10"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="0"
                                                                                                                           Text="Find"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="2"
                                                                                                                           Text="Replace with"
                                                                                                                           Style="{StaticResource FieldLabel}"/>

                                                                                                                <ui:TextBox Grid.Row="1"
                                                                                                                            Grid.Column="0"
                                                                                                                            Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                            PlaceholderText="Text to find…"/>
                                                                                                                <ui:TextBox Grid.Row="1"
                                                                                                                            Grid.Column="2"
                                                                                                                            Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                            PlaceholderText="Replace with (blank to delete)…"/>

                                                                                                                <StackPanel Grid.Row="3"
                                                                                                                            Grid.Column="0"
                                                                                                                            Grid.ColumnSpan="3"
                                                                                                                            Orientation="Horizontal">
                                                                                                                        <CheckBox Content="Match case"
                                                                                                                                  IsChecked="{Binding MatchCase, Mode=TwoWay}"
                                                                                                                                  Margin="0,0,16,0"/>
                                                                                                                        <CheckBox Content="Regular expressions"
                                                                                                                                  IsChecked="{Binding UseRegex, Mode=TwoWay}"
                                                                                                                                  Margin="0,0,16,0"/>
                                                                                                                        <CheckBox Content="Apply to extension"
                                                                                                                                  IsChecked="{Binding FindApplyToExtension, Mode=TwoWay}"/>
                                                                                                                </StackPanel>
                                                                                                        </Grid>

                                                                                                        <!-- INSERT TEXT -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=InsertText}">
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="10"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="10"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Text="Text to insert"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <ui:TextBox Grid.Row="1"
                                                                                                                            Text="{Binding InsertText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                            PlaceholderText="Text to insert…"/>

                                                                                                                <TextBlock Grid.Row="3"
                                                                                                                           Text="Position"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <StackPanel Grid.Row="4"
                                                                                                                            Orientation="Horizontal">
                                                        <RadioButton Content="Beginning"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding InsertPosition, Converter={StaticResource EnumBool}, ConverterParameter=Beginning, Mode=TwoWay}"/>
                                                        <RadioButton Content="End (before extension)"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding InsertPosition, Converter={StaticResource EnumBool}, ConverterParameter=End, Mode=TwoWay}"/>
                                                        <RadioButton Content="At character index:"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding InsertPosition, Converter={StaticResource EnumBool}, ConverterParameter=AtIndex, Mode=TwoWay}"/>
                                                                                                                        <ui:NumberBox Style="{StaticResource CompactSpinNumberBox}"
                                                                                                                                      Value="{Binding InsertIndex, Mode=TwoWay}"
                                                                                                                                      Minimum="0"
                                                                                                                                      Maximum="999"
                                                                                                                                      Width="80"
                                                                                                                                      IsEnabled="{Binding InsertPosition, Converter={StaticResource EnumBool}, ConverterParameter=AtIndex}"/>
                                                                                                                </StackPanel>

                                                                                                                <CheckBox Grid.Row="6"
                                                                                                                          Content="Apply to full filename including extension"
                                                                                                                          IsChecked="{Binding InsertApplyToExtension, Mode=TwoWay}"/>
                                                                                                        </Grid>

                                                                                                        <!-- REMOVE CHARACTERS -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=RemoveRange}">
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="10"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="8"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <StackPanel Grid.Row="0"
                                                                                                                            Orientation="Horizontal">
                                                        <RadioButton Content="From start"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding RemoveAnchor, Converter={StaticResource EnumBool}, ConverterParameter=FromStart, Mode=TwoWay}"/>
                                                        <RadioButton Content="From end"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding RemoveAnchor, Converter={StaticResource EnumBool}, ConverterParameter=FromEnd, Mode=TwoWay}"/>
                                                                                                                </StackPanel>

                                                                                                                <StackPanel Grid.Row="2"
                                                                                                                            Orientation="Horizontal">
                                                                                                                        <TextBlock Text="Starting at character"
                                                                                                                                   Style="{StaticResource FieldLabel}"
                                                                                                                                   Margin="0,0,8,0"/>
                                                                                                                        <ui:NumberBox Style="{StaticResource CompactSpinNumberBox}"
                                                                                                                                      Value="{Binding RemoveFrom, Mode=TwoWay}"
                                                                                                                                      Minimum="0"
                                                                                                                                      Maximum="999"
                                                                                                                                      Width="80"
                                                                                                                                      Margin="0,0,20,0"/>
                                                                                                                        <TextBlock Text="Remove"
                                                                                                                                   Style="{StaticResource FieldLabel}"
                                                                                                                                   Margin="0,0,8,0"/>
                                                                                                                        <ui:NumberBox Style="{StaticResource CompactSpinNumberBox}"
                                                                                                                                      Value="{Binding RemoveCount, Mode=TwoWay}"
                                                                                                                                      Minimum="1"
                                                                                                                                      Maximum="999"
                                                                                                                                      Width="80"
                                                                                                                                      Margin="0,0,8,0"/>
                                                                                                                        <TextBlock Text="character(s)"
                                                                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                                                                </StackPanel>

                                                                                                                <TextBlock Grid.Row="4"
                                                                                                                           FontSize="11"
                                                                                                                           Foreground="{StaticResource BrushTextTertiary}"
                                                                                                                           Text="'From end' counts backwards — position 0 from end = last character."/>
                                                                                                        </Grid>

                                                                                                        <!-- ADD SEQUENCE -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=AddSequence}">
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="10"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="10"/>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="10"/>
                                                                                                                        <ColumnDefinition Width="90"/>
                                                                                                                        <ColumnDefinition Width="10"/>
                                                                                                                        <ColumnDefinition Width="90"/>
                                                                                                                        <ColumnDefinition Width="10"/>
                                                                                                                        <ColumnDefinition Width="90"/>
                                                                                                                </Grid.ColumnDefinitions>

                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="0"
                                                                                                                           Text="Prefix"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="2"
                                                                                                                           Text="Suffix"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="4"
                                                                                                                           Text="Start #"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="6"
                                                                                                                           Text="Step"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <TextBlock Grid.Row="0"
                                                                                                                           Grid.Column="8"
                                                                                                                           Text="Pad zeros"
                                                                                                                           Style="{StaticResource FieldLabel}"/>

                                                                                                                <ui:TextBox Grid.Row="1"
                                                                                                                            Grid.Column="0"
                                                                                                                            Text="{Binding SeqPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                            PlaceholderText="e.g. IMG_"/>
                                                                                                                <ui:TextBox Grid.Row="1"
                                                                                                                            Grid.Column="2"
                                                                                                                            Text="{Binding SeqSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                            PlaceholderText="e.g. _v1"/>
                                                                                                                <ui:NumberBox Grid.Row="1"
                                                                                                                              Grid.Column="4"
                                                                                                                              Style="{StaticResource CompactSpinNumberBox}"
                                                                                                                              Value="{Binding SeqStart, Mode=TwoWay}"
                                                                                                                              Minimum="0"
                                                                                                                              />
                                                                                                                <ui:NumberBox Grid.Row="1"
                                                                                                                              Grid.Column="6"
                                                                                                                              Style="{StaticResource CompactSpinNumberBox}"
                                                                                                                              Value="{Binding SeqStep, Mode=TwoWay}"
                                                                                                                              Minimum="1"
                                                                                                                              />
                                                                                                                <ui:NumberBox Grid.Row="1"
                                                                                                                              Grid.Column="8"
                                                                                                                              Style="{StaticResource CompactSpinNumberBox}"
                                                                                                                              Value="{Binding SeqPadding, Mode=TwoWay}"
                                                                                                                              Minimum="1"
                                                                                                                              Maximum="10"
                                                                                                                              />

                                                                                                                <TextBlock Grid.Row="3"
                                                                                                                           Grid.Column="0"
                                                                                                                           Text="Insert sequence"
                                                                                                                           Style="{StaticResource FieldLabel}"
                                                                                                                           Margin="0,0,0,6"/>
                                                                                                                <StackPanel Grid.Row="4"
                                                                                                                            Grid.Column="0"
                                                                                                                            Grid.ColumnSpan="9"
                                                                                                                            Orientation="Horizontal">
                                                        <RadioButton Content="Before name"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding SeqPlace, Converter={StaticResource EnumBool}, ConverterParameter=Before, Mode=TwoWay}"/>
                                                        <RadioButton Content="After name"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding SeqPlace, Converter={StaticResource EnumBool}, ConverterParameter=After, Mode=TwoWay}"/>
                                                        <RadioButton Content="Replace entire name"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding SeqPlace, Converter={StaticResource EnumBool}, ConverterParameter=Replace, Mode=TwoWay}"/>
                                                                                                                </StackPanel>
                                                                                                        </Grid>

                                                                                                        <!-- CHANGE CASE -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=ChangeCase}">
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="10"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <StackPanel Grid.Row="0"
                                                                                                                            Orientation="Horizontal">
                                                        <RadioButton Content="UPPERCASE"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding CaseStyle, Converter={StaticResource EnumBool}, ConverterParameter=Uppercase, Mode=TwoWay}"/>
                                                        <RadioButton Content="lowercase"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding CaseStyle, Converter={StaticResource EnumBool}, ConverterParameter=Lowercase, Mode=TwoWay}"/>
                                                        <RadioButton Content="Title Case"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding CaseStyle, Converter={StaticResource EnumBool}, ConverterParameter=TitleCase, Mode=TwoWay}"/>
                                                        <RadioButton Content="Sentence case"
                                                                     Style="{StaticResource OptionRadio}"
                                                                     IsChecked="{Binding CaseStyle, Converter={StaticResource EnumBool}, ConverterParameter=SentenceCase, Mode=TwoWay}"/>
                                                                                                                </StackPanel>

                                                                                                                <CheckBox Grid.Row="2"
                                                                                                                          Content="Apply to extension as well"
                                                                                                                          IsChecked="{Binding CaseApplyToExtension, Mode=TwoWay}"/>
                                                                                                        </Grid>

                                                                                                        <!-- TRIM WHITESPACE -->
                                                                                                        <TextBlock Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=TrimSpaces}"
                                                                                                                   Text="Removes leading and trailing spaces, and collapses multiple internal spaces into one."
                                                                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                                                                   FontSize="12"
                                                                                                                   TextWrapping="Wrap"/>

                                                                                                        <!-- CHANGE EXTENSION -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=ChangeExtension}">
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <TextBlock Text="New extension"
                                                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                                                <ui:TextBox Text="{Binding NewExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                            PlaceholderText="e.g. jpg"/>
                                                                                                        </Grid>

                                                                                                        <!-- REMOVE NUMBERS -->
                                                                                                        <Grid Visibility="{Binding Type, Converter={StaticResource TypeVis}, ConverterParameter=RemoveNumbers}">
                                                                                                                <Grid.RowDefinitions>
                                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                                </Grid.RowDefinitions>

                                                                                                                <TextBlock Text="Remove all numbers from filename."
                                                                                                                           FontSize="12"/>
                                                                                                        </Grid>
                                                                                                </Grid>
                                                                                        </Border>
                                                                                </StackPanel>
                                                                        </Border>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </ScrollViewer>
                                </Grid>
                        </Border>

                        <!-- ══ FILES SECTION ════════════════════════════════════════ -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BrushCardBackground}"
                                BorderBrush="{StaticResource BrushCardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <!--
                            Files header: fixed at 46px to match the rules header height exactly.
                            Rules header = 9px top padding + 28px button + 9px bottom padding = 46px.
                        -->
                                                <RowDefinition Height="46"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Files header — same height as rules header -->
                                        <Border Grid.Row="0"
                                                BorderBrush="{StaticResource BrushCardBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,0">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Files"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource BrushTextTertiary}">
                                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                <Run Text="file(s) ·"/>
                                <Run Text="{Binding ChangedCount, Mode=OneWay}"/>
                                <Run Text="will be renamed"/>
                                                        </TextBlock>
                                                </StackPanel>
                                        </Border>

                                        <!-- Drop zone empty state -->
                                        <StackPanel Grid.Row="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Opacity="0.4"
                                                    Visibility="{Binding HasFiles, Converter={StaticResource InvBoolVis}}">
                                                <ui:SymbolIcon Symbol="ArrowUpload24"
                                                               FontSize="36"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>
                                                <TextBlock Text="Drop files or folders here"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                                <TextBlock Text="or use the Files menu"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           TextAlignment="Center"/>
                                        </StackPanel>

                                        <!--
                        Files DataGrid.
                        - AlternationCount="2" + AlternationIndex trigger in FileRow gives alternating rows.
                        - Column headers: bold, FontSize=11, Height=32 (matches rules column headers).
                        - Row text: TextFillColorPrimaryBrush (black in light, white in dark).
                    -->
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding Files}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  AlternationCount="2"
                                                  CanUserResizeRows="False"
                                                  CanUserSortColumns="True"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource BrushCardBorder}"
                                                  HeadersVisibility="Column"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  ColumnHeaderStyle="{StaticResource FilesColHeader}"
                                                  CellStyle="{StaticResource FilesCell}"
                                                  RowStyle="{StaticResource FileRow}"
                                                  Visibility="{Binding HasFiles, Converter={StaticResource BoolVis}}">

                                                <DataGrid.Columns>

                                                        <!-- Original-side indicator -->
                                                        <DataGridTemplateColumn Header=""
                                                                                Width="22"
                                                                                CanUserResize="False"
                                                                                CanUserSort="False">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                                <ui:SymbolIcon Symbol="ChevronRight24"
                                                                                               FontSize="10"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{StaticResource BrushTextTertiary}"
                                                                                               Visibility="{Binding HasChanges, Converter={StaticResource BoolVis}}"/>
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <!-- Original filename -->
                                                        <DataGridTemplateColumn Header="Original Filename"
                                                                                Width="*"
                                                                                SortMemberPath="OriginalName">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock Text="{Binding OriginalName}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           FontSize="12"
                                                                                           Padding="10,0"
                                                                                           ToolTip="{Binding OriginalPath}"
                                                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <!-- Rename indicator -->
                                                        <DataGridTemplateColumn Header=""
                                                                                Width="32"
                                                                                CanUserResize="False"
                                                                                CanUserSort="False">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                                <ui:SymbolIcon Symbol="ArrowRight24"
                                                                                               FontSize="12"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{StaticResource BrushSuccess}"
                                                                                               Visibility="{Binding HasChanges, Converter={StaticResource BoolVis}}"/>
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <!-- Updated filename -->
                                                        <DataGridTemplateColumn Header="Updated Filename"
                                                                                Width="*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock Text="{Binding NewName}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           FontSize="12"
                                                                                           Padding="10,0"
                                                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <!-- Remove button -->
                                                        <DataGridTemplateColumn Header=""
                                                                                Width="36"
                                                                                CanUserResize="False"
                                                                                CanUserSort="False">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                                <Button Width="24"
                                                                                        Height="24"
                                                                                        Padding="0"
                                                                                        Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                        HorizontalAlignment="Center"
                                                                                        ToolTip="Remove from list"
                                                                                        Command="{Binding DataContext.RemoveFileCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                        CommandParameter="{Binding}">
                                                                                        <ui:SymbolIcon Symbol="Dismiss24"
                                                                                                       FontSize="11"
                                                                                                       Foreground="{StaticResource BrushTextTertiary}"/>
                                                                                </Button>
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                </DataGrid.Columns>
                                        </DataGrid>

                                </Grid>
                        </Border>
                </Grid>

                <!-- ── Success Message ────────────────────────────────────────── -->
                <ui:InfoBar Grid.Row="2"
                            Title="Success"
                            Message="{Binding SuccessMessage}"
                            Severity="Success"
                            IsOpen="{Binding ShowSuccess}"
                            IsClosable="True"
                            Margin="12,4"/>

                <!-- ── Footer with buttons ────────────────────────────────────── -->
                <Border Grid.Row="3"
                        Background="{StaticResource BrushApplicationBackground}"
                        BorderBrush="{StaticResource BrushCardBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="14,8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <ui:Button Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           Command="{Binding ResetPreviewsCommand}"
                                           ToolTip="Clear all rules and reset previews">
                                        <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowReset24"
                                                               Margin="0,0,6,0"/>
                                                <TextBlock Text="Reset"/>
                                        </StackPanel>
                                </ui:Button>
                                <ui:Button Appearance="Primary"
                                           Command="{Binding ApplyRenamesCommand}"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                        <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Checkmark24"
                                                               Margin="0,0,6,0"/>
                                                <TextBlock Text="Apply Changes"/>
                                        </StackPanel>
                                </ui:Button>
                        </StackPanel>
                </Border>
        </Grid>
</ui:FluentWindow>
