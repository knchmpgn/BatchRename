<Application x:Class="BatchRename.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme applied dynamically in App.xaml.cs to match Windows app mode -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ════════════════════════════════════════════════════════════════
                 NORMALIZED COLOR PALETTE - Light & Dark Themes

                 11 vastly different colors, with light and dark variants.
                 The WPF UI theme library will switch these automatically.
                 ════════════════════════════════════════════════════════════════ -->

            <!-- ── LIGHT THEME COLORS ────────────────────────────────────────── -->
            <!-- Text Colors - Light Theme -->
            <Color x:Key="ColorTextPrimary">#212121</Color>
            <Color x:Key="ColorTextSecondary">#757575</Color>
            <Color x:Key="ColorTextTertiary">#BDBDBD</Color>

            <!-- Accent Colors - Light Theme -->
            <Color x:Key="ColorAccentPrimary">#0078D4</Color>
            <Color x:Key="ColorAccentLight">#E8F4F8</Color>

            <!-- Background - Light Theme -->
            <Color x:Key="ColorBackground">#FFFFFF</Color>

            <!-- Fill - Light Theme -->
            <Color x:Key="ColorFill">#F5F5F5</Color>

            <!-- Border - Light Theme -->
            <Color x:Key="ColorBorder">#E0E0E0</Color>

            <!-- State Colors - Both Themes (universal) -->
            <Color x:Key="ColorSuccess">#107C10</Color>
            <Color x:Key="ColorWarning">#FFB900</Color>
            <Color x:Key="ColorCritical">#E81123</Color>

            <!-- ── DARK THEME COLORS ────────────────────────────────────────── -->
            <!-- Text Colors - Dark Theme -->
            <Color x:Key="ColorTextPrimary_Dark">#FFFFFF</Color>
            <Color x:Key="ColorTextSecondary_Dark">#B0B0B0</Color>
            <Color x:Key="ColorTextTertiary_Dark">#707070</Color>

            <!-- Accent Colors - Dark Theme -->
            <Color x:Key="ColorAccentPrimary_Dark">#60CDFF</Color>
            <Color x:Key="ColorAccentLight_Dark">#1F3A52</Color>

            <!-- Background - Dark Theme -->
            <Color x:Key="ColorBackground_Dark">#1F1F1F</Color>

            <!-- Fill - Dark Theme -->
            <Color x:Key="ColorFill_Dark">#2D2D2D</Color>

            <!-- Border - Dark Theme -->
            <Color x:Key="ColorBorder_Dark">#3F3F3F</Color>

            <!-- ── BRUSHES - LIGHT THEME ────────────────────────────────────── -->
            <!-- Text Brushes -->
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
            <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}"/>

            <!-- Accent Brushes -->
            <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}"/>
            <SolidColorBrush x:Key="BrushAccentLight" Color="{StaticResource ColorAccentLight}"/>

            <!-- Background & Container Brushes -->
            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}"/>
            <SolidColorBrush x:Key="BrushCardBackground" Color="{StaticResource ColorBackground}"/>

            <!-- Fill Brushes -->
            <SolidColorBrush x:Key="BrushFill" Color="{StaticResource ColorFill}"/>
            <SolidColorBrush x:Key="BrushControlFillDefault" Color="{StaticResource ColorFill}"/>
            <SolidColorBrush x:Key="BrushControlFillTertiary" Color="{StaticResource ColorFill}"/>
            <SolidColorBrush x:Key="BrushSubtleFillSecondary" Color="{StaticResource ColorFill}"/>
            <SolidColorBrush x:Key="BrushSubtleFillTertiary" Color="{StaticResource ColorFill}"/>

            <!-- Border Brushes -->
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
            <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorBorder}"/>

            <!-- State Brushes (Universal) -->
            <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
            <SolidColorBrush x:Key="BrushCritical" Color="{StaticResource ColorCritical}"/>

            <!-- Application Background -->
            <SolidColorBrush x:Key="BrushApplicationBackground" Color="{StaticResource ColorBackground}"/>

            <!-- ── BRUSHES - DARK THEME ────────────────────────────────────── -->
            <!-- Text Brushes - Dark -->
            <SolidColorBrush x:Key="BrushTextPrimary_Dark" Color="{StaticResource ColorTextPrimary_Dark}"/>
            <SolidColorBrush x:Key="BrushTextSecondary_Dark" Color="{StaticResource ColorTextSecondary_Dark}"/>
            <SolidColorBrush x:Key="BrushTextTertiary_Dark" Color="{StaticResource ColorTextTertiary_Dark}"/>

            <!-- Accent Brushes - Dark -->
            <SolidColorBrush x:Key="BrushAccentPrimary_Dark" Color="{StaticResource ColorAccentPrimary_Dark}"/>
            <SolidColorBrush x:Key="BrushAccentLight_Dark" Color="{StaticResource ColorAccentLight_Dark}"/>

            <!-- Background & Container Brushes - Dark -->
            <SolidColorBrush x:Key="BrushBackground_Dark" Color="{StaticResource ColorBackground_Dark}"/>
            <SolidColorBrush x:Key="BrushCardBackground_Dark" Color="{StaticResource ColorBackground_Dark}"/>

            <!-- Fill Brushes - Dark -->
            <SolidColorBrush x:Key="BrushFill_Dark" Color="{StaticResource ColorFill_Dark}"/>
            <SolidColorBrush x:Key="BrushControlFillDefault_Dark" Color="{StaticResource ColorFill_Dark}"/>
            <SolidColorBrush x:Key="BrushControlFillTertiary_Dark" Color="{StaticResource ColorFill_Dark}"/>
            <SolidColorBrush x:Key="BrushSubtleFillSecondary_Dark" Color="{StaticResource ColorFill_Dark}"/>
            <SolidColorBrush x:Key="BrushSubtleFillTertiary_Dark" Color="{StaticResource ColorFill_Dark}"/>

            <!-- Border Brushes - Dark -->
            <SolidColorBrush x:Key="BrushBorder_Dark" Color="{StaticResource ColorBorder_Dark}"/>
            <SolidColorBrush x:Key="BrushCardBorder_Dark" Color="{StaticResource ColorBorder_Dark}"/>

            <!-- Application Background - Dark -->
            <SolidColorBrush x:Key="BrushApplicationBackground_Dark" Color="{StaticResource ColorBackground_Dark}"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
