<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="false"/>
  <appSettings>
    <!-- Disable automatic DPI scaling - use PerMonitorV2 from manifest instead -->
    <add key="DpiAwareness" value="PerMonitorV2"/>
  </appSettings>
  <runtime>
    <!-- Enable high DPI awareness - defer to OS and manifest -->
    <generatePublisherEvidence enabled="false"/>
  </runtime>
</configuration>
